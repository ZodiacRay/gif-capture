<Window x:Class="GifCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico" Title="GifCapture" Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}">
    <StackPanel>
        <!-- Shown only when a newer release exists. -->
        <Border x:Name="UpdateBanner" Visibility="Collapsed" Padding="14,10"
                Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2">
            <StackPanel>
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap"/>
                <ProgressBar x:Name="UpdateBar" Height="6" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="UpdateBtn" Style="{StaticResource RecordButton}" Content="업데이트" Click="Update_Click" Padding="14,4" Margin="0,0,6,0"/>
                    <Button x:Name="LaterBtn" Content="나중에" Click="Later_Click" Padding="14,4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,16,16,8">
            <Button Style="{StaticResource RecordButton}" Content="● 녹화 시작" Click="Record_Click" Padding="8,6" Margin="0,0,0,8"/>
            <Button Content="📂 GIF 불러오기" Click="Open_Click" Padding="8,4" Margin="0,0,0,8"/>
            <Button Content="{DynamicResource ThemeLabel}" Click="Theme_Click" Padding="8,4"/>
        </StackPanel>

        <DockPanel Margin="16,0,16,10">
            <Button x:Name="CheckBtn" DockPanel.Dock="Right" Content="업데이트 확인" Click="Check_Click"
                    Padding="8,2" FontSize="11" BorderThickness="0" Background="Transparent"/>
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>
        </DockPanel>
        <CheckBox x:Name="AutoCheck" Content="시작할 때 새 버전 확인" FontSize="11" Opacity="0.8" Margin="16,0,16,12"
                  Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"
                  ToolTip="켜 두면 시작할 때 GitHub에서 최신 릴리스 정보를 한 번 조회합니다"/>
    </StackPanel>
</Window>
